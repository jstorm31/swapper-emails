{
  "name": "react-email-starter",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "build": "email build",
    "dev": "email dev",
    "export": "email export && node scripts/fix-handlebars.mjs",
    "sync": "node --env-file-if-exists=.env scripts/sync-sendgrid.mjs",
    "sync:dry": "node --env-file-if-exists=.env scripts/sync-sendgrid.mjs --dry-run",
    "deploy": "npm run export && npm run sync"
  },
  "dependencies": {
    "@react-email/components": "1.0.8",
    "@react-email/font": "0.0.10",
    "@sendgrid/client": "^8.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@react-email/preview-server": "5.2.8",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "react-email": "5.2.8"
  }
}
